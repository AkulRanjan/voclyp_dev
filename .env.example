# VoClyp local-development environment. Copy to `.env` and fill in.
# `.env` is git-ignored and loaded automatically by the gateway, the worker,
# and scripts/run_sleep_company.py. In production these come from a secrets
# manager (see docs/DEPLOY-AWS.md) — never commit real secrets.

# --- Sarvam AI (speech-to-text + diarization + translate) ------------------
# Your Sarvam subscription key (the 100k-credit STT key). When set, the stack
# auto-selects configs/pipeline.sarvam.json (saaras:v3 diarized batch STT +
# saarika live STT + Mayura translate). Leave blank to run the free stub.
SARVAM_API_KEY=

# --- Voiceprint / speaker-ID backend ---------------------------------------
# acoustic = dependency-free baseline (default). aws = delegate to
# voclyp/voice/aws.py (SageMaker / Transcribe speaker embeddings).
VOCLYP_VOICEPRINT_BACKEND=acoustic

# --- AWS (deployment + optional speaker-embedding backend) -----------------
# Local dev only; in AWS use IAM task roles, not static keys.
AWS_REGION=ap-south-1
# AWS_ACCESS_KEY_ID=
# AWS_SECRET_ACCESS_KEY=
# VOCLYP_VOICEPRINT_SAGEMAKER_ENDPOINT=

# --- Platform secrets / config ---------------------------------------------
# 32+ random bytes; enables audio encryption at rest. Generate with:
#   python -c "import secrets; print(secrets.token_hex(32))"
VOCLYP_MASTER_KEY=
# Signs console session tokens (falls back to MASTER_KEY in dev).
VOCLYP_SESSION_SECRET=
# development | production (production fails closed without a session secret).
VOCLYP_ENV=development
# Override pipeline selection (otherwise auto: sarvam when SARVAM_API_KEY set).
# VOCLYP_PIPELINE_CONFIG=configs/pipeline.sarvam.json
