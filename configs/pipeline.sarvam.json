{
  "version": "1.4-sarvam-diarized",
  "description": "Production field pipeline: Sarvam Saaras v3 batch STT with 2-speaker diarization (agent+customer), voiceprint relabeling, background speaker drop, Mayura translate, taxonomy signals, transcript-based summary.",
  "stages": [
    {
      "role": "asr",
      "impl": "sarvam_batch",
      "options": {
        "model": "saaras:v3",
        "mode": "codemix",
        "language_code": "unknown",
        "num_speakers": 2,
        "timeout_s": 900,
        "relabel_speakers": true,
        "voiceprint_threshold": 0.65
      }
    },
    { "role": "diarization", "impl": "passthrough" },
    { "role": "speaker_id", "impl": "voiceprint", "options": { "threshold": 0.65 } },
    { "role": "lang_id_translation", "impl": "sarvam" },
    { "role": "pii_redaction", "impl": "regex" },
    { "role": "audio_deletion", "impl": "vault" },
    { "role": "signal_extraction", "impl": "taxonomy" },
    { "role": "summarization", "impl": "sarvam_llm", "options": { "model": "sarvam-30b" } }
  ]
}
